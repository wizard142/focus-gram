<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.wizard142.focusgram" android:versionCode="1" android:versionName="0.3.0">
  <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
  <application android:label="Focus Gram Guard" android:allowBackup="false" android:supportsRtl="true">
    <service android:name=".FocusService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/focus_service" />
    </service>
    <receiver android:name=".ControlReceiver" android:exported="true" android:permission="android.permission.DUMP">
      <intent-filter><action android:name="io.github.wizard142.focusgram.SET_FOCUS" /></intent-filter>
    </receiver>
  </application>
</manifest>
