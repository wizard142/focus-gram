{
  "name": "focus-gram",
  "version": "0.1.0",
  "description": "Create more. Scroll less. A Linux-first reel studio with a focused Instagram workspace.",
  "author": "wizard142",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.mjs",
    "pack": "npm run build && electron-builder --linux dir",
    "dist": "npm run build && electron-builder --linux AppImage tar.gz",
    "test:desktop": "npm run build && node tests/desktop.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "io.github.wizard142.focusgram",
    "productName": "Focus Gram",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "public/icon.png",
      "desktop": {
        "entry": {
          "Keywords": "Instagram;Video;Reels;Focus;Editor;"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wizard142/focus-gram.git"
  },
  "homepage": "https://github.com/wizard142/focus-gram",
  "bugs": {
    "url": "https://github.com/wizard142/focus-gram/issues"
  }
}
